# Discogs API
# Get your token from: https://www.discogs.com/settings/developers
DISCOGS_USER_TOKEN=your_discogs_token_here

# Spotify API
# Create an app at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# SoundCloud API
# Create an app at: https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id
SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret
SOUNDCLOUD_REDIRECT_URI=http://localhost:8889/callback

# Application Settings (optional)
# DATA_DIR=~/.song_automations
# PLAYLIST_PREFIX=Discogs -
# HIGH_CONFIDENCE=0.50
# LOG_LEVEL=INFO

# true also adds official SoundCloud uploads the account cannot play in full, such as Go+ releases
SOUNDCLOUD_GATED_TRACKS=false

# true never opens a browser or waits for one; a run that needs a login stops with a message instead (the daily schedule runs this way)
UNATTENDED=false

# Seconds to wait for a login page to be approved in the browser before giving up
LOGIN_WAIT_SECONDS=600
